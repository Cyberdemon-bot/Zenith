// === INPUT: ASM ===
; Proto #0: Callee (a: R0, b: R1) -> returns (a * 2) + (b - 3) and (a - b)
.proto
.params 2
.regs 6

LoadImm   R2, 2
LoadImm   R3, 3
Mul.I32   R4, R0, R2
Sub.I32   R5, R1, R3
Add.I32   R2, R4, R5
Sub.I32   R3, R0, R1
Return    R2, 2

; Proto #1: Main entry
.proto
.params 0
.regs 6

LoadImm   R0, 100
LoadImm   R2, 15
LoadImm   R3, 8
Call      R2, Proto#0
; After Call at base R2: R2 holds 1st return (15*2 + 8-3 = 35), R3 holds 2nd return (15-8 = 7)
Add.I32   R4, R2, R3
Halt

// === EXPECTED VM ===
R0 = 100 (I32)
R2 = 35 (I32)
R3 = 7 (I32)
R4 = 42 (I32)
