// === INPUT: ASM ===
.params 0
.regs 10

LoadImm   R0, -10
LoadImm   R1, 10

; Signed vs Unsigned Lt
Lt.I32    R2, R0, R1
Lt.U32    R3, R0, R1

; Eq and LNot
Eq.I32    R4, R0, R1
LNot      R5, R4
LNot      R6, R5

; Mov
Mov       R7, R0
Eq.I32    R8, R7, R0
Halt

// === EXPECTED VM ===
R2 = 1 (U64)
R3 = 0 (U64)
R4 = 0 (U64)
R5 = 1 (U64)
R6 = 0 (U64)
R7 = -10 (I32)
R8 = 1 (U64)
