func main() {
    let x: i8 = 10;
    {
        let x: f64 = 2.5;
        let y = x + 1.0;
    }
    let z: i8 = x + 1;

    let mut n = 0;
    let loop_val: i64 = for {
        'inner: {
            n = n + 1;
            if n == 2 {
                break n;
            }
            break 'inner;
        };
    };

    let grade: u8 = if loop_val < 1 => 0
                    else if loop_val == 2 => 100
                    else => 255;
}
