// === INPUT: SOURCE ===
func abs_f64(x: f64) -> f64 {
    return if x < 0.0 => -x else => x;
}

func mod_pow(base_in: u64, exp_in: u64, m: u64) -> u64 {
    let mut result: u64 = 1;
    let mut base: u64 = base_in % m;
    let mut exp: u64 = exp_in;

    for exp > 0 {
        if exp % 2 == 1 {
            result = (result * base) % m;
        }
        base = (base * base) % m;
        exp = exp / 2;
    }
    return result;
}

func is_prime(n: u64) -> bool {
    if n < 2 {
        return false;
    }
    if n == 2 or n == 3 {
        return true;
    }
    if n % 2 == 0 or n % 3 == 0 {
        return false;
    }
    if mod_pow(2, n - 1, n) != 1 {
        return false;
    }

    let mut d: u64 = 5;
    for d * d <= n {
        if n % d == 0 or n % (d + 2) == 0 {
            return false;
        }
        d = d + 6;
    }
    return true;
}

func nth_prime(target: i64) -> u64 {
    let mut found: i64 = 0;
    let mut cand: u64 = 1;

    return 'search: for {
        cand = cand + 1;
        if !is_prime(cand) {
            continue;
        }
        found = found + 1;
        if found == target {
            break 'search cand;
        }
    };
}

func collatz_steps(n_in: i64) -> i64 {
    let mut n: i64 = n_in;
    let mut steps: i64 = 0;
    for n != 1 {
        if n % 2 == 0 {
            n = n / 2;
        } else {
            n = n * 3 + 1;
        }
        steps = steps + 1;
    }
    return steps;
}

func newton_sqrt(x: f64) -> f64 {
    let mut guess: f64 = if x > 1.0 => x * 0.5 else => 1.0;
    return 'iter: for {
        let next: f64 = 0.5 * (guess + x / guess);
        if abs_f64(next - guess) < 0.000001 {
            break 'iter next;
        }
        guess = next;
    };
}

func main() -> i64 {
    let p25 = nth_prime(25) as i64;                     // 97
    let mp = (mod_pow(3, 13, 1000000007) % 10000) as i64; // 4323

    let mut best_n: i64 = 1;
    let mut best_steps: i64 = 0;
    let mut k: i64 = 1;
    for k <= 30 {
        let s = collatz_steps(k);
        if s > best_steps {
            best_steps = s;
            best_n = k;
        }
        k = k + 1;
    }

    let sqrt2_scaled = (newton_sqrt(2.0) * 10000.0) as i64; // 14142
    let sqrt144 = (newton_sqrt(144.0) + 0.5) as i64;        // 12

    return p25 + mp + best_n * 1000 + best_steps + sqrt2_scaled + sqrt144;
}

