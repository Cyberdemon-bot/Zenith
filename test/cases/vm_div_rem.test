// === INPUT: ASM ===
.params 0
.regs 10

; Signed division and remainder
LoadImm   R0, -23
LoadImm   R1, 5
DivS.I32  R2, R0, R1
RemS.I32  R3, R0, R1

; Unsigned division and remainder
LoadImm   R4, 100
LoadImm   R5, 30
DivU.U32  R6, R4, R5
RemU.U32  R7, R4, R5

; 64-bit signed division and remainder
.const I64 -10000000007
.const I64 10
LoadConst R0, K0
LoadConst R1, K1
DivS.I64  R8, R0, R1
RemS.I64  R9, R0, R1
Halt

// === EXPECTED VM ===
R2 = -4 (I32)
R3 = -3 (I32)
R6 = 3 (U32)
R7 = 10 (U32)
R8 = -1000000000 (I64)
R9 = -7 (I64)
