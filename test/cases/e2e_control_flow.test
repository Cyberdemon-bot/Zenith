// === INPUT: SOURCE ===
func main() -> i64 {
    let x = if 3 < 5 => 10 else => 20;

    let sc1 = false and (10 / 0 == 1);
    let sc2 = true or (10 / 0 == 1);
    let sc_val = if !sc1 and sc2 => 100 else => 0;

    let b = 'blk: {
        let t = 7;
        if t > 5 {
            break 'blk t * 3;
        }
        break 'blk 0;
    };

    let mut acc: i64 = 0;
    let mut i: i64 = 0;
    for i < 10 {
        i = i + 1;
        if i % 2 == 0 {
            continue;
        }
        acc = acc + i;
    }

    return x + sc_val + b + acc;
}

