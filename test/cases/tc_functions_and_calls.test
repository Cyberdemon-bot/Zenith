// === INPUT: SOURCE ===
func fact(n: i64) -> i64 {
    if n <= 1 {
        return 1;
    }
    return n * fact(n - 1);
}

func mix(a: u8, b: f32, ok: bool) -> f32 {
    if ok {
        return (a as f32) + b;
    }
    return b;
}

func greet() {
    let mut i = 0;
    for i < 3 {
        i = i + 1;
    }
}

func main() {
    let f = fact(5);
    let m = mix(10, 2.5, true);
    let pick = if f > 10 => m else => 0.0;
    greet();
}
