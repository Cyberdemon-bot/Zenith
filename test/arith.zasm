NOP

.CONST I 100          ; K[0] = 100      (int64)
.CONST I 30           ; K[1] = 30       (int64)
.CONST F 3.14159      ; K[2] = 3.14159  (float64), unused directly, just a demo

LOADI 10 100          ; R64[10] = K[?] where value 100 -> reuses K[0]
LOADI 11 30           ; R64[11] = K[?] where value 30  -> reuses K[1]
MOVE  12 10           ; R64[12] = R64[10]

; ---- Integer arithmetic (64-bit) ----
ADD_I64 13 10 11      ; R64[13] = 100 + 30
SUB_I64 14 10 11      ; R64[14] = 100 - 30
MUL_I64 15 10 11      ; R64[15] = 100 * 30
DIV_I64 16 10 11      ; R64[16] = 100 / 30

; ---- Convert to double and repeat in float arithmetic ----
CVT_I64_F64 17 10     ; R64[17] = double(100)
CVT_I64_F64 18 11     ; R64[18] = double(30)
ADD_F64 19 17 18      ; R64[19] = 100.0 + 30.0
SUB_F64 20 17 18      ; R64[20] = 100.0 - 30.0
MUL_F64 21 17 18      ; R64[21] = 100.0 * 30.0
DIV_F64 22 17 18      ; R64[22] = 100.0 / 30.0
CVT_F64_I64 23 22     ; R64[23] = int64(3.3333...)

; ---- Big-number 64-bit arithmetic (values preset by the host) ----
ADD_I64 3 1 2         ; R64[3] = 10B + 2B
SUB_I64 4 1 2         ; R64[4] = 10B - 2B
MUL_I64 5 1 2         ; R64[5] = 10B * 2B
DIV_I64 6 1 2         ; R64[6] = 10B / 2B

CVT_I64_F64 7 1       ; R64[7] = double(10B)
CVT_I64_F64 8 2       ; R64[8] = double(2B)
ADD_F64 24 7 8        ; R64[24] = 10B.0 + 2B.0
SUB_F64 25 7 8        ; R64[25] = 10B.0 - 2B.0
MUL_F64 26 7 8        ; R64[26] = 10B.0 * 2B.0
DIV_F64 27 7 8        ; R64[27] = 10B.0 / 2B.0
CVT_F64_I64 28 27     ; R64[28] = int64(5.0)

; ---- Extra LOADF sanity check using a value not pre-declared ----
LOADF 29 2.71828      ; R64[29] = 2.71828 (auto-interned, new pool slot)

HALT