// DIAG(Name, Code, Severity, Template)

// Syntax & Parser
DIAG(UnexpectedToken,      100, Error, "{0}")
DIAG(ExpectedToken,        101, Error, "{0}")
DIAG(InvalidSyntax,        102, Error, "{0}")
DIAG(InvalidStatement,     103, Error, "{0}")
DIAG(InvalidLiteral,       104, Error, "{0}")
DIAG(NestingTooDeep,       105, Error, "Nesting is too deep")

// Declaration & Signature 
DIAG(DuplicateFunction,    200, Error, "Duplicate function '{0}'")
DIAG(MissingMainFunction,  201, Error, "Program must define 'func main'")
DIAG(InvalidMainSignature, 202, Error, "Invalid signature for 'main'")
DIAG(UnknownTypeName,      203, Error, "Unknown type '{0}'")

// Scope & Symbol 
DIAG(UnknownIdentifier,    210, Error, "Unknown identifier '{0}'")
DIAG(RedeclaredIdentifier, 211, Error, "Redeclared identifier '{0}'")

// Expression & Operation
DIAG(OperandTypeMismatch,  220, Error, "Invalid operand type '{actual}' for operator '{0}'")
DIAG(InvalidUnaryOp,       221, Error, "Unsupported unary operator '{0}'")
DIAG(InvalidBinaryOp,      222, Error, "Operands of '{0}' must have the same type (got '{expected}' and '{actual}')")
DIAG(WrongArgCount,        223, Error, "Argument count mismatch: expected {0}, got {1}")
DIAG(CannotInferType,      224, Error, "Cannot infer type")
DIAG(CoerceFailure,        225, Error, "Invalid type cast from '{actual}' to '{expected}'")
DIAG(LiteralOutOfRange,    226, Error, "Literal out of range for '{expected}'")

// Type Mismatch 
DIAG(TypeMismatch,         230, Error, "Type mismatch: expected '{expected}', got '{actual}'")
DIAG(LetTypeMismatch,      231, Error, "Let binding type mismatch: expected '{expected}', got '{actual}'")
DIAG(ReturnTypeMismatch,   232, Error, "Return type mismatch: expected '{expected}', got '{actual}'")
DIAG(ArgTypeMismatch,      233, Error, "Argument type mismatch: expected '{expected}', got '{actual}'")
DIAG(AssignTypeMismatch,   234, Error, "Assignment type mismatch: expected '{expected}', got '{actual}'")
DIAG(BreakTypeMismatch,    235, Error, "Break value type mismatch: expected '{expected}', got '{actual}'")
DIAG(MissingReturn,        236, Error, "Function '{0}' must return a value")

// Statement & Control Flow 
DIAG(ImmutableAssignment,  240, Error, "Cannot assign twice to immutable variable '{0}'")
DIAG(InvalidAssignTarget,  241, Error, "Invalid assignment target")
DIAG(UndeclaredLabel,      242, Error, "Undeclared label '{0}'")
DIAG(InvalidContinue,      243, Error, "'continue' must target an enclosing loop")
DIAG(BreakOutsideLoop,     244, Error, "'break' outside of loop or block")
DIAG(BlockMissingBreak,    245, Error, "Block does not break with a value of expected type")

// General 
DIAG(UnsupportedFeature,   290, Error, "Unsupported feature: {0}")
DIAG(TooManyErrors,        291, Error, "Too many errors")

// CodeGen 
DIAG(RegisterOverflow,     300, Error, "Function '{0}' exceeds maximum register limit (255)")
DIAG(ConstantPoolOverflow, 301, Error, "Function '{0}' exceeds maximum constant pool limit (65535)")
DIAG(JumpOffsetOverflow,   302, Error, "Jump offset out of range in function '{0}'")
