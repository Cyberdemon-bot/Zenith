// 01_arithmetic.zen: Literals, arithmetic precedence, comparisons, and tuples

func main() {
    print("=== 01: Arithmetic & Literals ===");

    let a = 10 + 2 * 5;
    let b = (10 + 2) * 5;
    let c = 17 / 5;
    let d = 17 % 5;
    let f = 3.5 * 2.0 - 0.5;

    print("10 + 2 * 5 =", a);
    print("(10 + 2) * 5 =", b);
    print("17 / 5 =", c, "| 17 % 5 =", d);
    print("3.5 * 2.0 - 0.5 =", f);

    let logic_and = true and (5 > 3);
    let logic_or = false or (10 == 10);
    let neg = !false and (-a == -20);
    print("logic_and:", logic_and, "| logic_or:", logic_or, "| neg:", neg);

    let unit_val = ();
    let pair = (42, "zenith");
    print("unit:", unit_val, "| pair:", pair, "| pair[0]:", pair[0], "| pair[1]:", pair[1]);

    assert(a == 20, "a should be 20");
    assert(b == 60, "b should be 60");
    assert(c == 3 and d == 2, "integer division/modulo mismatch");
    assert(logic_and and logic_or and neg, "boolean logic mismatch");
}
