// 02_variables_mut.zen: Variable bindings, mutability, shadowing, and references

func main() {
    print("=== 02: Variables, Mutability & References ===");

    let immut_val: i32 = 100;
    let mut counter = 0;
    counter = counter + 10;
    counter = counter + 5;
    print("immut_val:", immut_val, "| counter:", counter);

    // Lexical shadowing inside a block
    {
        let immut_val = 999;
        counter = counter + 1;
        print("inner shadowed immut_val:", immut_val, "| counter:", counter);
    }
    print("outer immut_val after block:", immut_val);

    // Borrowing and dereferencing
    let r_read = &immut_val;
    let r_mut = mut &counter;
    print("deref *r_read:", *r_read, "| deref *r_mut:", *r_mut);

    *r_mut = 50;
    print("counter after *r_mut = 50:", counter);

    assert(immut_val == 100, "outer immut_val should remain 100");
    assert(counter == 50, "counter should be updated to 50 via mutable ref");
}
