// 03_control_flow.zen: If expressions (arrow and block) and for loops

func main() {
    print("=== 03: Control Flow (If & For) ===");

    let x = 15;
    let sign = if x < 0 => "negative"
               else if x == 0 => "zero"
               else => "positive";
    print("x =", x, "is", sign);

    // Conditional for loop
    let mut sum = 0;
    let mut i = 1;
    for i <= 5 {
        sum = sum + i;
        i = i + 1;
    }
    print("sum 1..5 =", sum);

    // For-in loop with range() and continue
    let mut odd_sum = 0;
    for n in range(1, 10) {
        if n % 2 == 0 {
            continue;
        }
        odd_sum = odd_sum + n;
    }
    print("sum of odds in 1..9 =", odd_sum);

    // Infinite loop with labeled break
    let mut steps = 0;
    'loop: for {
        steps = steps + 1;
        if steps == 4 {
            break 'loop;
        }
    }
    print("infinite loop exited at steps =", steps);

    assert(sign == "positive", "sign check failed");
    assert(sum == 15, "sum 1..5 should be 15");
    assert(odd_sum == 25, "sum of odds 1+3+5+7+9 should be 25");
    assert(steps == 4, "steps should be 4");
}
