          (BlockExpr
            (ExprStmt
              (CallExpr
                (Identifier "process")
                (ArgList
                  (Identifier "item")
                )
              )
            )
          )
        )
      )
      (ExprStmt
        (ForInExpr
          (Identifier "item")
          (BorrowExpr :mut true
            (Identifier "list")
          )
          (BlockExpr
            (ExprStmt
              (CallExpr
                (Identifier "process")
                (ArgList
                  (Identifier "item")
                )
              )
            )
          )
        )
      )
      (ExprStmt
        (ForInExpr
          (Identifier "item")
          (CallExpr
            (Identifier "range")
            (ArgList
              (Integer 10)
            )
          )
          (BlockExpr
            (ContinueStmt)
          )
        )
      )
      (ExprStmt
        (LabeledExpr
          (Label "outer")
          (ForInExpr
            (Identifier "item")
            (CallExpr
              (Identifier "range")
              (ArgList
                (Integer 10)
              )
            )
            (BlockExpr
              (ContinueStmt
                (Label "outer")
              )
            )
          )
        )
      )
      (ExprStmt
