                )
              )
            )
          )
        )
      )
      (ExprStmt
        (ForExpr
          (BlockExpr
            (ExprStmt
              (CallExpr
                (Identifier "process")
                (ArgList
                  (Integer 1)
                )
              )
            )
          )
        )
      )
      (ExprStmt
        (ForInExpr
          (Identifier "item")
          (Identifier "items")
