func demo() {
    for ready { process(x); }
    for { process(1); }
    for item in items { process(item); }
    for item in &list { process(item); }
    for item in &mut list { process(item); }
    for item in range(10) { continue; }
    'outer: for item in range(10) { continue 'outer; }
    'forever: for { break 'forever; }
    'scan: for item in items { if item == target { break 'scan; } }
    'maybe: if ready { break 'maybe; }
}

// === EXPECTED AST ===
(Program
  (FuncDecl
