func demo() {
    let a = if x > 0 => 1 else => 0;
    let b = if x < 0 => "neg"
            else if x == 0 => "zero"
            else => "pos";
    if ready => process(x);
    if ready { process(x); } else if other { process(y); } else { process(z); }
    let nested = if (if x > 0 => true else => false) => 1 else => -1;
}

// === EXPECTED AST ===
(Program
  (FuncDecl
    (FuncSign
      (Identifier "demo")
      (ArgList)
    )
    (BlockExpr
      (LetStmt
        (Identifier "a")
        (IfExpr
          (BinaryExpr :op ">"
            (Identifier "x")
            (Integer 0)
          )
          (Integer 1)
          (Integer 0)
        )
      )
      (LetStmt
        (Identifier "b")
        (IfExpr
          (BinaryExpr :op "<"
            (Identifier "x")
            (Integer 0)
          )
          (String "neg")
          (IfExpr
            (BinaryExpr :op "=="
              (Identifier "x")
              (Integer 0)
            )
            (String "zero")
            (String "pos")
          )
        )
      )
      (ExprStmt
        (IfExpr
          (Identifier "ready")
          (CallExpr
            (Identifier "process")
            (ArgList
              (Identifier "x")
            )
          )
        )
      )
      (ExprStmt
        (IfExpr
          (Identifier "ready")
          (BlockExpr
            (ExprStmt
              (CallExpr
                (Identifier "process")
                (ArgList
                  (Identifier "x")
                )
              )
            )
          )
          (IfExpr
            (Identifier "other")
            (BlockExpr
              (ExprStmt
                (CallExpr
                  (Identifier "process")
                  (ArgList
                    (Identifier "y")
                  )
                )
              )
            )
            (BlockExpr
              (ExprStmt
                (CallExpr
                  (Identifier "process")
                  (ArgList
                    (Identifier "z")
                  )
                )
              )
            )
          )
        )
      )
      (LetStmt
        (Identifier "nested")
        (IfExpr
          (ParenExpr
            (IfExpr
              (BinaryExpr :op ">"
                (Identifier "x")
                (Integer 0)
              )
              (Bool true)
              (Bool false)
            )
          )
          (Integer 1)
          (UnaryExpr :op "-"
            (Integer 1)
          )
        )
      )
    )
  )
)
